<UserControl
    x:Class="SensoryStudio.WinUI.Experiences.ZenGardenExperience"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#B8A98F">
        <WebView2 x:Name="Browser" />
        <Border
            x:Name="LoadingPanel"
            Background="#B8A98F">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16">
                <ProgressRing
                    Width="48"
                    Height="48"
                    Foreground="#574A38"
                    IsActive="True" />
                <TextBlock
                    Text="Preparing garden..."
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Foreground="#574A38" />
            </StackPanel>
        </Border>
        <Border x:Name="ErrorPanel" Background="#B8A98F" Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                Foreground="#574A38"
                TextWrapping="Wrap"
                TextAlignment="Center"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="24" />
        </Border>
    </Grid>
</UserControl>
